{
  "name": "@cobalt/ui",
  "version": "1.0.0",
  "description": "Cobalt's design system & UI library",
  "scripts": {
    "codegen": "typed-scss-modules . -e default -n none -i components -i styles -i node_modules --aliasPrefixes.@cobalt/ui .",
    "codegen:watch": "watchexec --exts scss --watch . npm run codegen",
    "types": "tsc --noEmit",
    "test": "TZ=UTC vitest",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test-coverage": "TZ=UTC vitest run --coverage",
    "docs": "npx ts-node scripts/generate-docs.ts",
    "prepare": "husky install"
  },
  "author": "Cobalt Engineers",
  "license": "UNLICENSED",
  "peerDependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^3.0.0",
    "date-fns-tz": "^3.0.0",
    "framer-motion": "^6.5.1",
    "lodash": "^4.17.21",
    "react": "^17.0.0",
    "react-aria-components": "^1.0.0",
    "react-dom": "^17.0.0",
    "react-hook-form": "^7.53.2",
    "react-icons": "^4.12.0",
    "react-test-renderer": "^17.0.0"
  },
  "devDependencies": {
    "@storybook/addon-a11y": "^8.4.7",
    "@storybook/addon-essentials": "^8.4.7",
    "@storybook/addon-interactions": "^8.4.7",
    "@storybook/addon-links": "^8.4.7",
    "@storybook/blocks": "^8.4.7",
    "@storybook/jest": "^0.2.2",
    "@storybook/react": "^8.4.7",
    "@storybook/react-vite": "^8.4.7",
    "@storybook/testing-library": "^0.2.2",
    "@testing-library/jest-dom": "^5.14.1",
    "@testing-library/react": "^12.0.0",
    "@testing-library/react-hooks": "1.1.0",
    "@testing-library/user-event": "^13.2.1",
    "@types/lodash": "^4.17.13",
    "@types/lru-cache": "^5.1.1",
    "@types/react": "^17.0.0",
    "@types/react-copy-to-clipboard": "^5.0.2",
    "@types/react-dom": "^17.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "@vitest/coverage-v8": "^2.1.8",
    "husky": "^8.0.3",
    "jsdom": "^25.0.1",
    "lint-staged": "^15.5.1",
    "prettier": "^3.4.2",
    "react-docgen-typescript": "^2.2.2",
    "resize-observer-polyfill": "^1.5.1",
    "sass": "^1.82.0",
    "sass-embedded": "^1.82.0",
    "storybook": "^8.4.7",
    "typed-scss-modules": "^8.0.1",
    "typescript": "^5.7.2",
    "vite": "5",
    "vite-plugin-svgr": "^4.3.0",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "@tanstack/react-table": "^8.20.5",
    "@types/react-helmet": "^6.1.11",
    "animate.css": "^4.1.1",
    "class-variance-authority": "^0.7.1",
